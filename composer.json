{
  "name": "kduma/eloquent-sluggable",
  "description": "Eases using and generating slugs Laravel Eloquent models.",
  "keywords": ["laravel", "eloquent", "slug"],
  "license": "MIT",
  "authors": [
    {
      "name": "Krystian Duma",
      "email": "oss@krystian.duma.sh"
    }
  ],
  "require": {
    "php": "^8.3",
    "illuminate/support": "^13.0",
    "illuminate/database": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "KDuma\\Eloquent\\": "src/"
    }
  },
  "minimum-stability": "dev",
  "extra": {
    "branch-alias": {
      "dev-master-v1": "1.x-dev",
      "dev-master": "2.x-dev"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "mockery/mockery": "^1.6"
  }
}
